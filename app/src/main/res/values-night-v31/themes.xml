<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Continuo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/continuo_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/continuo_accent_light</item>
        <item name="android:colorControlActivated">@color/continuo_accent_light</item>
        <item name="android:textColorHighlight">#405B9BC0</item>
        <item name="android:windowSplashScreenBackground">@color/continuo_ink_night</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/continuo_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_splash_night</item>
        <item name="android:windowSplashScreenAnimationDuration">950</item>
    </style>
</resources>
